<script is:inline>
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // hero: cursor-reactive aurora (parallax de profundidad)
  var hero = document.querySelector('.hero');
  if(hero && !rm && window.matchMedia('(pointer:fine)').matches){
    hero.addEventListener('pointermove', function(e){
      var r = hero.getBoundingClientRect();
      var x = ((e.clientX - r.left)/r.width*100);
      var y = ((e.clientY - r.top)/r.height*100);
      hero.style.setProperty('--mx', x.toFixed(1)+'%');
      hero.style.setProperty('--my', (28 + y*0.18).toFixed(1)+'%');
    });
  }

  // hero: parallax sutil al scroll
  var sea = document.querySelector('.sea');
  if(sea && !rm){
    window.addEventListener('scroll', function(){
      var y = window.scrollY || 0;
      if(y < window.innerHeight){ sea.style.transform = 'translateY(' + (y*0.18) + 'px)'; }
    }, {passive:true});
  }

  // hero: pavesas de luz ascendentes
  var em = document.getElementById('embers');
  if(em && !rm){
    var N = window.innerWidth < 640 ? 14 : 26;
    for(var i=0;i<N;i++){
      var s = document.createElement('span'); s.className='ember';
      var dur = 7 + Math.random()*9, delay = -Math.random()*16, size = 2 + Math.random()*2.5;
      s.style.left = (Math.random()*100)+'%';
      s.style.width = s.style.height = size+'px';
      s.style.animationDuration = dur+'s';
      s.style.animationDelay = delay+'s';
      s.style.setProperty('--drift', (Math.random()*60-30)+'px');
      em.appendChild(s);
    }
  }

  // scroll reveal
  if(!rm && 'IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold:.16, rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.rv').forEach(function(el){ el.classList.add('in'); });
  }

  // nav solidify + waterline progress
  var nav = document.getElementById('nav'), wl = document.getElementById('wl');
  function onScroll(){
    var y = window.scrollY || document.documentElement.scrollTop;
    if(y > 40) nav.classList.add('solid'); else nav.classList.remove('solid');
    var h = document.documentElement.scrollHeight - window.innerHeight;
    wl.style.height = (h>0 ? (y/h*100) : 0) + 'vh';
  }
  window.addEventListener('scroll', onScroll, {passive:true}); onScroll();

  // FAQ accordion
  document.querySelectorAll('.qa button').forEach(function(btn){
    btn.addEventListener('click', function(){
      var qa = btn.closest('.qa'); var open = qa.classList.contains('open');
      qa.classList.toggle('open', !open);
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
})();
</script>
<script>
  /* ░░ HÉROE CINEMATOGRÁFICO · secuencia de fotogramas escarbada por scroll ░░
     Motor: canvas frame-scrub + Lenis (scroll suave) + GSAP ScrollTrigger.
     Póster instantáneo → los 100 frames del arca hacen stream en 2.º plano →
     al terminar, el scroll empuja la cámara hacia el casco fotograma a fotograma. */
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';
  import { FrameSequence } from '../lib/frameSequence.js';

  gsap.registerPlugin(ScrollTrigger);

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scene = document.getElementById('scene');
  const canvas = document.getElementById('arcaCanvas');

  if (scene && canvas) {
    const beats = Array.from(scene.querySelectorAll('.beat'));
    // Ventanas de aparición por progreso (0..1), casi continuas: sin tramos mudos largos
    const ranges = [[0, 0.25], [0.28, 0.50], [0.53, 0.75], [0.79, 1.01]];
    const setBeats = (p) => {
      beats.forEach((b, i) => {
        const r = ranges[i];
        b.classList.toggle('on', p >= r[0] && p < r[1]);
      });
      scene.classList.toggle('ended', p > 0.05);
    };

    const seq = new FrameSequence(canvas, {
      base: '/frames/hero',
      poster: '/assets/arca-hero-poster.jpg',
    });
    // Póster al instante — nunca se bloquea esperando la descarga completa
    seq.showPoster().then(() => canvas.classList.add('is-ready'));

    if (reduce) {
      beats.forEach((b, i) => b.classList.toggle('on', i === 0));
    } else {
      // Lenis: scroll suave (la firma "premium" del scrub)
      const lenis = new Lenis({
        duration: 1.15,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        touchMultiplier: 1.4,
        lerp: 0.1,
      });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);
      window.addEventListener('scroll', () => ScrollTrigger.update(), { passive: true });

      // Anclas internas a través de Lenis (los CTA de WhatsApp son https:// → no les afecta)
      document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const id = a.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          lenis.scrollTo(target, { offset: 0, duration: 1.3 });
        });
      });

      // Los beats se revelan por scroll aunque los frames aún no hayan cargado
      ScrollTrigger.create({
        trigger: scene, start: 'top top', end: 'bottom bottom', scrub: true,
        onUpdate: (self) => setBeats(self.progress),
      });

      // Stream de frames en 2.º plano → al terminar, scrub fotograma a fotograma
      seq.loadFrames().then(() => {
        const last = Math.max(0, seq.count - 1);
        if (seq.count <= 1) return; // sin frames → se queda el póster
        seq.render(0);
        ScrollTrigger.create({
          trigger: scene, start: 'top top', end: 'bottom bottom', scrub: 0.5,
          onUpdate: (self) => seq.render(Math.round(self.progress * last)),
        });
        ScrollTrigger.refresh();
      });
    }

    setBeats(0);
    window.addEventListener('load', () => ScrollTrigger.refresh());
  }
</script>

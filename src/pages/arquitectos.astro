---
import Base from "../layouts/Base.astro";
import { WA_CTA, ARQUITECTOS, FUNDACION } from "../config/arka.js";

const titulo = "Los Arquitectos · Ed Zam y Val Mosquera";
const descripcion =
  "Quién traza el rumbo de EL ARKA. Ed Zam, El Arquitecto de Realidades, y Val Mosquera, La Arquitecta de Realidades. La visión no descansa en una cabeza: descansa en un pacto.";
---
<Base titulo={titulo} descripcion={descripcion} ruta="/arquitectos/">

<Fragment slot="head">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org","@type":"NGO","name":"EL ARKA",
    "url":"https://elarka.ong",
    "foundingDate":"2026-07-23",
    "foundingLocation":{"@type":"Place","name":"Mérida, Yucatán, México"},
    "founder":ARQUITECTOS.map(a=>({"@type":"Person","name":a.nombre,"jobTitle":a.rol}))
  })} />
</Fragment>

<header class="portada">
  <div class="contenedor">
    <p class="etiqueta">Los Arquitectos</p>
    <h1 class="display">Somos dos.<br>Y vemos <span class="sentencia">lo mismo</span>.</h1>
  </div>
</header>

<!-- ░░░░ LOS VOTOS · en positivo, porque aquí manda lo humano ░░░░ -->
<section class="mov positivo votos-sec" aria-labelledby="h-votos">
  <div class="contenedor">
    <div class="votos">
      {ARQUITECTOS.map((a, i) => (
        <article class={`voto revelar d${i + 1}`}>
          <blockquote>{a.voto}</blockquote>
          <p class="quien"><b>{a.nombre}</b><span>{a.rol}</span></p>
        </article>
      ))}
    </div>
    <p class="cierre-votos revelar d2">No diseñamos edificios. Diseñamos Realidades.
      <span class="sentencia">La visión no descansa en una sola cabeza: descansa en un pacto.</span>
      Por eso no nos hundimos — y por eso podemos sostenerte a ti.</p>
  </div>
</section>

<!-- ░░░░ EL LEGADO ░░░░ -->
<section class="mov" aria-labelledby="h-legado">
  <div class="contenedor">
    <div class="dos-tercios">
      <div>
        <p class="etiqueta revelar">El legado</p>
        <h2 class="titulo revelar d1" id="h-legado">Un Arka no se construye<br>para quien la construye.</h2>
      </div>
      <div class="revelar d2">
        <p>Se construye por todos los que caben dentro. Ese es el legado: que ningún emprendedor,
          ningún empresario, ningún soñador con algo verdadero entre las manos cruce este diluvio solo.</p>
        <p><span class="sentencia">No salvamos a uno: ayudamos a que millones alcancen su libertad.</span></p>
        <p>Y el día que ya no estemos, lo que quede no será nuestro nombre, sino cada familia que
          llegó a la orilla porque, esta vez, no la dejamos cruzar sola.</p>
      </div>
    </div>
  </div>
</section>

<!-- ░░░░ LA FICHA · el único lugar del sitio donde vive la fundación ░░░░ -->
<section class="mov ficha-sec" aria-labelledby="h-ficha">
  <div class="contenedor">
    <p class="etiqueta revelar">La organización</p>
    <h2 class="titulo revelar d1" id="h-ficha">Los datos, sin adornos.</h2>
    <dl class="ficha revelar d2">
      <div><dt class="rotulo">Nombre</dt><dd>EL ARKA <span class="nota">(con K)</span></dd></div>
      <div><dt class="rotulo">Naturaleza</dt><dd>Organización sin fines de lucro · comunidad · plataforma de formación</dd></div>
      <div><dt class="rotulo">Fundación</dt><dd>{FUNDACION.fecha}</dd></div>
      <div><dt class="rotulo">Sede</dt><dd>{FUNDACION.lugar}</dd></div>
      <div><dt class="rotulo">Territorio</dt><dd>América Latina y el mundo de habla hispana</dd></div>
      <div><dt class="rotulo">Arquitectos</dt><dd>Ed Zam · Val Mosquera</dd></div>
      <div><dt class="rotulo">Modelo</dt><dd>Los ingresos por membresías, formación y alianzas se reinvierten íntegramente en la misión</dd></div>
      <div><dt class="rotulo">Prensa y marca</dt><dd><a href="/prensa/">elarka.ong/prensa</a></dd></div>
    </dl>
  </div>
</section>

<section class="mov final" aria-labelledby="h-cta">
  <div class="contenedor">
    <h2 class="titulo revelar" id="h-cta">Nosotros trazamos el plano.<br>
      <span class="sentencia">Tú decides si subes.</span></h2>
    <div class="botones revelar d1">
      <a href={WA_CTA} target="_blank" rel="noopener" class="boton principal">Solicitar abordar</a>
      <a href="/prensa/" class="boton contorno">Prensa y marca</a>
    </div>
  </div>
</section>

<style>
.portada{padding:calc(var(--aire-vasto) + 60px) 0 var(--aire-base);
  background:linear-gradient(180deg,var(--abismo),var(--hondo))}
.display{font-size:var(--t-display);margin:22px 0 0;line-height:1}
.mov{padding:var(--aire-base) 0}
.titulo{font-size:var(--t-titulo);margin-top:20px}
.mov p + p{margin-top:16px}

/* Los votos: terracota manda porque aquí lo que habla es lo humano */
.votos-sec{background:var(--marfil);padding:var(--aire-vasto) 0}
.votos{display:grid;gap:2px}
@media(min-width:860px){.votos{grid-template-columns:1fr 1fr;gap:56px}}
.voto blockquote{font-family:var(--sans);font-weight:var(--peso-aire);
  font-size:clamp(23px,1.9vw + 15px,34px);line-height:1.24;letter-spacing:-.025em;
  color:var(--tinta-oscura);position:relative;padding-left:26px}
.voto blockquote::before{content:"«";position:absolute;left:0;top:-.06em;
  color:var(--terra-hondo);font-size:1.1em;font-weight:300}
.voto blockquote::after{content:"»";color:var(--terra-hondo);margin-left:.08em}
.voto .quien{margin-top:20px;padding-left:26px}
.voto .quien b{display:block;font-family:var(--sans);font-weight:var(--peso-sentencia);
  font-size:var(--t-cuerpo);color:var(--tinta-oscura);letter-spacing:-.01em}
.voto .quien span{display:block;margin-top:2px;font-family:var(--sans);
  font-size:var(--t-micro);font-weight:600;letter-spacing:var(--track-inline);
  text-transform:uppercase;color:var(--terra-hondo)}
.cierre-votos{margin-top:52px;max-width:62ch;color:var(--tinta-oscura-suave);font-size:var(--t-cuerpo)}

.dos-tercios{display:grid;gap:30px}
@media(min-width:900px){.dos-tercios{grid-template-columns:2fr 3fr;gap:64px;align-items:start}}
.dos-tercios p{color:var(--tinta-suave)}

/* La ficha: dato puro, sin decoración */
.ficha-sec{background:var(--media-agua)}
.ficha{margin-top:42px;display:grid;gap:1px;background:var(--linea-tenue);
  border-top:1px solid var(--linea-tenue);border-bottom:1px solid var(--linea-tenue)}
.ficha > div{background:var(--media-agua);padding:16px 0;display:grid;gap:4px}
@media(min-width:720px){.ficha > div{grid-template-columns:220px 1fr;gap:28px;align-items:baseline}}
.ficha dd{color:var(--tinta-suave);font-size:var(--t-menor);line-height:1.6}
.ficha dd a{color:var(--terra-luz);border-bottom:1px solid rgba(208,138,102,.4)}
.ficha .nota{color:var(--tinta-tenue);font-style:italic}

.final{background:linear-gradient(180deg,var(--media-agua),var(--abismo));
  padding:var(--aire-vasto) 0 var(--aire-base)}
.botones{margin-top:32px;display:flex;gap:13px;flex-wrap:wrap}
</style>
</Base>

---
import Base from "../layouts/Base.astro";
import { WA_CTA, NICHOS, PAISES, JURAMENTO, JURAMENTO_SELLO } from "../config/arka.js";

const titulo = "EL ARKA — Lidera esta era. Construye tu libertad.";
const descripcion =
  "El mundo entrena para usar la IA. EL ARKA te forma para liderarla. Comunidad y organización sin fines de lucro que forma a emprendedores y empresarios de habla hispana para liderar la era de la Inteligencia Artificial.";
---
<Base titulo={titulo} descripcion={descripcion} ruta="/">

<Fragment slot="head">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org","@type":"NGO","name":"EL ARKA",
    "alternateName":["ARKAI","ARKADIA"],
    "slogan":"Lidera esta era. Construye tu libertad.",
    "url":"https://elarka.ong","nonprofitStatus":"Nonprofit",
    "description":"Comunidad y organización sin fines de lucro que forma a emprendedores y empresarios de habla hispana para liderar la era de la Inteligencia Artificial, no solo para usarla.",
    "areaServed":{"@type":"Place","name":"América Latina y el mundo de habla hispana"},
    "founder":[{"@type":"Person","name":"Ed Zam"},{"@type":"Person","name":"Val Mosquera"}],
    "logo":"https://elarka.ong/assets/arka-simbolo-marfil.svg"
  })} />
</Fragment>

<!-- ░░░░ ESCENA · el arka en construcción, escarbada por scroll ░░░░ -->
<section class="escena" id="escena" aria-label="EL ARKA">
  <div class="fija">
    <canvas id="lienzo" class="lienzo" aria-hidden="true"></canvas>
    <div class="velo" aria-hidden="true"></div>
    <div class="horizonte" aria-hidden="true"></div>

    <div class="tiempos">
      <div class="tiempo t1">
        <p class="etiqueta sin-filete">Las primeras gotas ya caen</p>
        <h1>
          <span class="l">Lidera</span>
          <span class="l">esta era.</span>
          <span class="l sentencia">Construye tu libertad.</span>
        </h1>
      </div>

      <div class="tiempo t2">
        <p class="grande">No viene.<br><span class="sentencia">Ya empezó.</span></p>
        <p class="menor">La inteligencia artificial está volviendo obsoleto, casi de un día para otro,
          lo que ayer parecía seguro. Oficios enteros. Negocios que costaron años.</p>
      </div>

      <div class="tiempo t3">
        <p class="grande">El mundo entrena para <span class="apagado">usar</span> la IA.<br>
          <span class="sentencia">Nosotros te formamos para liderarla.</span></p>
        <p class="menor">Mientras el mercado vende atajos, El Arka empieza donde nadie empieza: por ti.</p>
      </div>

      <div class="tiempo t4">
        <p class="grande">Sube. <span class="sentencia">También es tuya.</span></p>
        <div class="botones">
          <a href={WA_CTA} target="_blank" rel="noopener" class="boton principal">Solicitar abordar</a>
          <a href="/travesia/" class="boton contorno">Ver La Travesía</a>
        </div>
      </div>
    </div>

    <div class="pista" aria-hidden="true"><span>Asciende</span><i></i></div>
  </div>
</section>

<!-- ░░░░ LOS DOS NICHOS ░░░░ -->
<section class="mov" aria-labelledby="h-juego">
  <div class="contenedor">
    <p class="etiqueta revelar">Para quién construimos</p>
    <h2 class="titulo revelar d1" id="h-juego">Esto no se trata de ponerte al día.<br>
      Se trata de <span class="sentencia">tu libertad</span>.</h2>
    <p class="guia lectura revelar d2">La libertad de un negocio sostenible que te sostenga a ti y a
      tu familia. La paz de saber que lo que levantaste no se lo lleva la próxima ola.</p>

    <div class="nichos">
      {NICHOS.map((n, i) => (
        <article class={`nicho revelar d${i + 1}`}>
          <h3>{n.titulo}</h3>
          <p class="entrada">{n.linea}</p>
          <dl>
            <dt class="rotulo">Lo que está en juego</dt><dd>{n.dolor}</dd>
            <dt class="rotulo">La orilla</dt><dd>{n.orilla}</dd>
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ░░░░ EL CORTE EN POSITIVO · la tesis ░░░░ -->
<section class="mov positivo corte" aria-labelledby="h-tesis">
  <div class="contenedor">
    <p class="etiqueta revelar">La diferencia</p>
    <h2 class="titulo revelar d1" id="h-tesis">La IA no te hará consciente.<br>
      Solo <span class="sentencia">amplifica tu estado</span>.</h2>
    <div class="tesis">
      <div class="revelar d2">
        <p>Le das poder a alguien que aún se sabotea, y solo se saboteará más rápido, más caro
          y más fuerte. Como el martillo no hace al carpintero pero multiplica su golpe,
          la IA no te hace: amplifica lo que ya eres.</p>
      </div>
      <div class="revelar d3">
        <p>Por eso restauramos el orden natural: <span class="sentencia">el ser humano en el centro,
          la IA a su servicio</span>. Una herramienta que no dominas, te domina.</p>
        <p class="cierre-tesis">No te volvemos más rápido. Te volvemos otro. Porque el mundo que viene
          no premia al que sabe más, sino al que dejó de sabotearse.</p>
      </div>
    </div>
    <a href="/travesia/" class="boton contorno revelar d3" style="margin-top:36px">Cómo lo hacemos</a>
  </div>
</section>

<!-- ░░░░ EL ARKA ░░░░ -->
<section class="mov" aria-labelledby="h-arka">
  <div class="contenedor">
    <div class="dos-tercios">
      <div>
        <p class="etiqueta revelar">El Arka</p>
        <h2 class="titulo revelar d1" id="h-arka">No es una metáfora.<br><span class="sentencia">Es real.</span></h2>
      </div>
      <div class="revelar d2">
        <p>EL ARKA es el nodo cero: el punto de origen del que nace todo lo demás, y la única que habrá.
          Una plataforma, una comunidad y una organización sin fines de lucro donde se reúnen los que
          fueron valientes.</p>
        <p><span class="sentencia">«Sin fines de lucro» no significa sin recursos.</span> Significa que
          aquí nadie se hace rico a tu costa: cada peso que entra vuelve al Arka, para abrir más nodos
          y subir a bordo a más gente. El mundo quiere venderte la salida; el Arka quiere financiarte
          la travesía.</p>
        <p class="aparte">No entra cualquiera. Entra quien elige cruzar y está dispuesto a remar.
          Pero al que sube, no lo soltamos jamás.</p>
        <a href="/ciudadania/" class="boton contorno" style="margin-top:24px">La ciudadanía</a>
      </div>
    </div>
  </div>
</section>

<!-- ░░░░ EL TERRITORIO ░░░░ -->
<section class="mov territorio" aria-labelledby="h-territorio">
  <div class="contenedor">
    <p class="etiqueta revelar">El territorio</p>
    <h2 class="titulo revelar d1" id="h-territorio">Una sola lengua.<br>
      <span class="sentencia">Veinte orillas.</span></h2>
    <p class="guia lectura revelar d2">El Arka cruza en español. Abrimos nodos hasta cubrir cada rincón
      donde alguien quiera cruzar — de México a la Patagonia, y de vuelta a España.</p>
    <ul class="banderas revelar d3" aria-label="Países de habla hispana donde navega El Arka">
      {PAISES.map((p) => (
        <li><span class="b" aria-hidden="true">{p.b}</span><span class="n">{p.n}</span></li>
      ))}
    </ul>
    <a href="/flota/" class="boton contorno revelar d3" style="margin-top:32px">Conocer La Flota</a>
  </div>
</section>

<!-- ░░░░ EL PACTO ░░░░ -->
<section class="mov positivo pacto" aria-labelledby="h-pacto">
  <div class="contenedor">
    <p class="etiqueta revelar">El Pacto del Arka</p>
    <h2 class="titulo revelar d1" id="h-pacto">No se firma con tinta.<br>
      Se firma <span class="sentencia">subiendo</span>.</h2>
    <p class="guia lectura revelar d2">Nosotros nos comprometemos a llevarte de la intemperie a tierra
      firme: a reprogramarte desde la raíz, a entregarte las herramientas de la nueva era, a no lucrar
      a tu costa y a no soltarte jamás. Tú te comprometes a remar.</p>

    <div class="juramento revelar d2">
      <p class="rotulo">El Juramento del Constructor</p>
      <ol>
        {JURAMENTO.map((linea) => <li>{linea}</li>)}
      </ol>
      <p class="sello sentencia">{JURAMENTO_SELLO}</p>
    </div>
  </div>
</section>

<!-- ░░░░ CIERRE ░░░░ -->
<section class="mov final" aria-labelledby="h-final">
  <div class="contenedor">
    <h2 class="display revelar" id="h-final">Puedes quedarte a la intemperie.<br>
      O <span class="sentencia">tomar la decisión de los valientes</span>.</h2>
    <p class="guia revelar d1" style="margin-top:28px;max-width:52ch">Hoy puedes ser Constructor.
      Mañana solo quedará abordar lo ya construido.</p>
    <div class="botones revelar d2" style="margin-top:36px">
      <a href={WA_CTA} target="_blank" rel="noopener" class="boton principal">Solicitar abordar</a>
      <a href="/diluvio/" class="boton contorno">Empezar por el principio</a>
    </div>
    <p class="rotulo revelar d3" style="margin-top:28px">Los Constructores se nombran una sola vez en la historia del Arka</p>
  </div>
</section>

<style>
.escena{position:relative;height:420vh;background:var(--abismo)}
.fija{position:sticky;top:0;height:100vh;overflow:hidden;background:var(--abismo)}
.lienzo{position:absolute;inset:0;width:100%;height:100%;
  opacity:0;transition:opacity .8s var(--ease)}
.lienzo.lista{opacity:1}
.velo{position:absolute;inset:0;z-index:1;pointer-events:none;
  background:linear-gradient(180deg,rgba(6,20,31,.66) 0%,rgba(6,20,31,.2) 30%,rgba(6,20,31,.34) 62%,rgba(6,20,31,.88) 100%)}
.horizonte{position:absolute;left:0;bottom:18%;width:100%;height:1px;z-index:1;pointer-events:none;
  background:linear-gradient(90deg,transparent,rgba(40,184,216,.38) 26%,rgba(94,216,240,.6) 50%,rgba(40,184,216,.38) 74%,transparent)}

.tiempos{position:absolute;inset:0;z-index:3;display:flex;align-items:center;
  padding:0 clamp(20px,5vw,72px)}
.tiempo{position:absolute;max-width:1040px;left:clamp(20px,5vw,72px);right:clamp(20px,5vw,72px);
  opacity:0;transform:translateY(18px);pointer-events:none;
  transition:opacity .15s ease-in,transform .15s ease-in}
.tiempo.activo{opacity:1;transform:none;pointer-events:auto;
  transition:opacity .62s var(--ease),transform .62s var(--ease)}
.tiempo h1{font-size:var(--t-display);line-height:.99}
.tiempo h1 .l{display:block}
.tiempo .grande{font-family:var(--sans);font-weight:var(--peso-aire);
  font-size:clamp(34px,5.4vw + 6px,80px);line-height:1.05;letter-spacing:-.028em}
.tiempo .apagado{color:var(--tinta-tenue)}
.tiempo .menor{margin-top:22px;max-width:52ch;color:var(--tinta-suave);font-size:var(--t-guia)}
.tiempo .botones{margin-top:34px;display:flex;gap:13px;flex-wrap:wrap}
.pista{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);z-index:4;
  display:flex;flex-direction:column;align-items:center;gap:9px;
  font-family:var(--sans);font-size:10px;letter-spacing:var(--track-estructural);
  text-transform:uppercase;color:var(--tinta-tenue);transition:opacity .4s}
.pista i{display:block;width:1px;height:34px;
  background:linear-gradient(var(--agua-luz),transparent)}
.escena.avanzada .pista{opacity:0}

.mov{padding:var(--aire-base) 0;position:relative}
.mov.corte,.mov.pacto{padding:var(--aire-vasto) 0}
.mov.final{padding:var(--aire-vasto) 0 var(--aire-base)}
.titulo{font-size:var(--t-titulo);margin:20px 0 0}
.display{font-size:var(--t-display);line-height:1.01}
.guia{font-size:var(--t-guia);color:var(--tinta-suave);margin-top:22px;line-height:1.6}
.positivo .guia{color:var(--tinta-oscura-suave)}
.mov p + p{margin-top:16px}

.nichos{display:grid;gap:1px;margin-top:52px;background:var(--linea-tenue);
  border-top:1px solid var(--linea-tenue);border-bottom:1px solid var(--linea-tenue)}
@media(min-width:820px){.nichos{grid-template-columns:1fr 1fr}}
.nicho{background:var(--abismo);padding:34px clamp(22px,3vw,38px)}
.nicho h3{font-family:var(--sans);font-weight:var(--peso-sentencia);
  font-size:var(--t-sub);color:var(--marfil);letter-spacing:-.02em}
.nicho .entrada{margin-top:12px;color:var(--tinta-suave);font-size:var(--t-cuerpo)}
.nicho dl{margin-top:24px;display:grid;gap:14px}
.nicho dt{margin-bottom:3px}
.nicho dd{font-size:var(--t-menor);color:var(--tinta-suave);line-height:1.6}

.corte{background:var(--marfil)}
.tesis{display:grid;gap:28px;margin-top:40px}
@media(min-width:820px){.tesis{grid-template-columns:1fr 1fr;gap:48px}}
.tesis p{font-size:var(--t-cuerpo)}
.cierre-tesis{font-family:var(--sans);font-weight:var(--peso-aire);
  font-size:var(--t-guia);line-height:1.35;letter-spacing:-.02em;
  color:var(--tinta-oscura);margin-top:20px}

.dos-tercios{display:grid;gap:30px}
@media(min-width:900px){.dos-tercios{grid-template-columns:2fr 3fr;gap:64px;align-items:start}}
.dos-tercios p{color:var(--tinta-suave)}

.territorio{background:var(--media-agua)}
.banderas{list-style:none;display:flex;flex-wrap:wrap;gap:9px;margin-top:38px}
.banderas li{display:inline-flex;align-items:center;gap:8px;
  border:1px solid var(--linea-tenue);border-radius:var(--borde);
  padding:8px 13px 8px 10px;background:rgba(244,240,232,.03);
  transition:border-color var(--dur-corta) var(--ease),background var(--dur-corta) var(--ease)}
.banderas li:hover{border-color:rgba(183,101,71,.5);background:rgba(183,101,71,.08)}
.banderas .b{font-size:17px;line-height:1}
.banderas .n{font-family:var(--sans);font-size:12px;font-weight:500;
  letter-spacing:.02em;color:var(--tinta-suave);white-space:nowrap}

.pacto{background:var(--marfil)}
.juramento{margin-top:52px;max-width:34em}
.juramento .rotulo{color:var(--terra-hondo);margin-bottom:22px}
.juramento ol{list-style:none;counter-reset:j;display:grid;gap:14px}
.juramento li{counter-increment:j;position:relative;padding-left:44px;
  font-family:var(--sans);font-weight:var(--peso-aire);
  font-size:clamp(19px,1.5vw + 14px,27px);line-height:1.32;
  letter-spacing:-.02em;color:var(--tinta-oscura)}
.juramento li::before{content:counter(j,upper-roman);position:absolute;left:0;top:.42em;
  font-family:var(--sans);font-size:11px;font-weight:600;letter-spacing:.1em;
  color:var(--terra-hondo);line-height:1}
.juramento .sello{margin-top:30px;padding-top:22px;
  border-top:1px solid rgba(15,36,56,.16);
  font-size:clamp(21px,1.7vw + 15px,30px);letter-spacing:-.02em}

.final{background:linear-gradient(180deg,var(--abismo),var(--hondo))}
.final .botones{display:flex;gap:13px;flex-wrap:wrap}

@media(prefers-reduced-motion:reduce){
  .escena{height:auto}
  .fija{position:relative;height:auto;min-height:100vh;
    background:var(--abismo) center/cover no-repeat url("/assets/arca-hero-poster.jpg")}
  .lienzo{display:none}
  .tiempos{position:relative;inset:auto;flex-direction:column;justify-content:center;
    gap:44px;padding-top:120px;padding-bottom:80px}
  .tiempo{position:relative;left:auto;right:auto;opacity:1;transform:none;pointer-events:auto}
  .pista{display:none}
}
</style>

<script>
  /* Escena cinematográfica: fotogramas escarbados por scroll.
     Póster instantáneo → frames en segundo plano → scrub.
     Sin GSAP ni Lenis: rAF puro, cero librerías. */
  import { FrameSequence } from "../lib/frameSequence.js";

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const escena = document.getElementById("escena");
  const lienzo = document.getElementById("lienzo");

  if (escena && lienzo) {
    const tiempos = Array.from(escena.querySelectorAll(".tiempo"));
    const rangos = [[0, 0.26], [0.29, 0.52], [0.55, 0.78], [0.81, 1.01]];

    const pintarTiempos = (p) => {
      tiempos.forEach((t, i) => t.classList.toggle("activo", p >= rangos[i][0] && p < rangos[i][1]));
      escena.classList.toggle("avanzada", p > 0.04);
    };

    const seq = new FrameSequence(lienzo, {
      base: "/frames/hero",
      poster: "/assets/arca-hero-poster.jpg",
    });
    seq.showPoster().then(() => lienzo.classList.add("lista"));

    if (reduce) {
      tiempos.forEach((t) => t.classList.add("activo"));
    } else {
      const progreso = () => {
        const total = escena.offsetHeight - window.innerHeight;
        return total > 0 ? Math.max(0, Math.min(1, -escena.getBoundingClientRect().top / total)) : 0;
      };

      let objetivo = 0, actual = 0, ultimo = -1, corriendo = false;
      const lerp = () => {
        actual += (objetivo - actual) * 0.14;
        if (seq.ready) {
          const i = Math.round(actual * (seq.count - 1));
          if (i !== ultimo) { seq.render(i); ultimo = i; }
        }
        if (Math.abs(objetivo - actual) > 0.0004) requestAnimationFrame(lerp);
        else corriendo = false;
      };

      const alScroll = () => {
        objetivo = progreso();
        pintarTiempos(objetivo);
        if (!corriendo) { corriendo = true; requestAnimationFrame(lerp); }
      };

      window.addEventListener("scroll", alScroll, { passive: true });
      window.addEventListener("resize", alScroll);
      seq.loadFrames().then(() => { if (seq.count > 1) { seq.render(0); alScroll(); } });
      pintarTiempos(0);
    }
  }
</script>
</Base>

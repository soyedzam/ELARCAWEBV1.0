---
/* EL FARO · plantilla única de pieza escrita (respuesta, laboratorio, ensayo, glosario).
   Respuesta directa arriba (AEO), fecha de actualización visible, JSON-LD por tipo
   y versión Markdown enlazada para agentes. Borradores: sólo en build de revisión, con noindex. */
import Base from "../../../layouts/Base.astro";
import { GUIAS } from "../../../config/faro.js";
import { piezas, urlPieza, seccion, fechaLarga, jsonLdPieza } from "../../../lib/faro.js";

export async function getStaticPaths() {
  const lista = await piezas();
  return lista.map((p) => ({ params: { tipo: p.data.tipo, slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await p.render();
const d = p.data;
const guia = d.guia ? GUIAS.find((g) => g.slug === d.guia) : null;
const ld = jsonLdPieza(p);
---
<Base titulo={`${d.titulo} · EL FARO · EL ARKA`} descripcion={d.descripcion} ruta={urlPieza(p)}>
  <Fragment slot="head">
    {d.borrador && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" type="text/markdown" href={`/faro/${d.tipo}/${p.slug}.md`} title="Versión para agentes (Markdown)" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>
  <article class="art">
    {d.imagen && <div class="portada" style={`background-image:url(${d.imagen})`}></div>}
    <div class="cuerpo">
      <nav class="miga" aria-label="Ruta"><a href="/faro/">EL FARO</a> · {seccion(d.tipo)?.nombre}</nav>
      {d.borrador && <p class="aviso">Borrador · no publicado</p>}
      <h1>{d.titulo}</h1>
      <p class="meta">{d.autor} · {fechaLarga(d.fecha)}{d.actualizada && <> · actualizado {fechaLarga(d.actualizada)}</>}</p>
      {d.respuesta && <div class="respuesta"><span>La respuesta corta</span><p>{d.respuesta}</p></div>}
      {guia && <a class="guia" href={`/faro/guias/${guia.slug}/`}>Encuentra el tuyo en 3 preguntas →</a>}
      <div class="texto"><Content /></div>
      {guia && <a class="guia" href={`/faro/guias/${guia.slug}/`}>Abrir la guía interactiva →</a>}
      <a class="volver" href="/faro/">← Volver a EL FARO</a>
    </div>
  </article>
</Base>

<style>
.art{--luz:#F4EDE2;--card:#FBF7F0;--tinta:#221E18;--meta:#6E6457;--oro:#C9963F;--orot:#7A5A1E;--tor:#0E1726;background:var(--luz);color:var(--tinta)}
.portada{height:min(56vh,480px);background:#0E1726 37% 25%/cover no-repeat}
.cuerpo{max-width:640px;margin:0 auto;padding:34px 22px 72px;font:20px/1.65 'Newsreader',Georgia,serif}
.miga{font:600 13px 'Inter',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--orot)}
.miga a{color:inherit;text-decoration:none}
.aviso{display:inline-block;background:var(--tor);color:var(--oro);font:600 12px 'Inter',sans-serif;letter-spacing:.14em;text-transform:uppercase;padding:5px 10px;border-radius:99px}
h1{font:600 clamp(36px,9vw,54px)/1.06 'Fraunces',Georgia,serif;margin:14px 0 10px}
.meta{font:500 15px 'Inter',sans-serif;color:var(--meta);margin:0 0 20px}
.respuesta{background:var(--tor);color:var(--luz);border-radius:18px;padding:20px 22px;margin:0 0 20px}
.respuesta span{display:block;font:600 12px 'Inter',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--oro);margin-bottom:6px}
.respuesta p{margin:0;font-size:21px;line-height:1.5}
.texto :global(h2){font:600 30px/1.15 'Fraunces',Georgia,serif;margin:38px 0 10px}
.texto :global(strong){font-weight:600}
.guia{display:block;text-align:center;background:var(--oro);color:var(--tor);font:600 18px 'Inter',sans-serif;padding:16px;border-radius:14px;margin:26px 0;text-decoration:none}
.volver{display:inline-block;margin-top:18px;font:600 15px 'Inter',sans-serif;color:var(--orot);text-decoration:none}
</style>

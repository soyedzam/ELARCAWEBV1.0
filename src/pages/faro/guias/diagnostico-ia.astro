---
/* EL FARO · Guía-diagnóstico: ¿Qué tanto puede la IA cambiar tu negocio?
   10 preguntas, dos ejes, un primer paso. Todo corre en el teléfono de quien contesta (E24):
   ninguna respuesta sale del dispositivo. Sin JS: se ven las preguntas y los cuatro resultados. */
import Base from "../../../layouts/Faro.astro";
import { PREGUNTAS, RESULTADOS } from "../../../config/diagnostico.js";
import { GUIAS } from "../../../config/faro.js";
import { WA_CTA } from "../../../config/arka.js";
import { migas, origen } from "../../../lib/faro.js";
const guia = GUIAS.find((g) => g.slug === "diagnostico-ia");
const ld = [
  { "@context": "https://schema.org", "@type": "Quiz", name: guia.titulo, description: guia.descripcion,
    url: origen + "/faro/guias/diagnostico-ia/", inLanguage: "es-MX", educationalLevel: "Dueños de negocio",
    publisher: { "@type": "Organization", name: "EL ARKA", url: origen } },
  migas([["EL FARO", "/faro/"], ["Guías", "/faro/#guias"], [guia.titulo, "/faro/guias/diagnostico-ia/"]]),
];
---
<Base titulo={`${guia.titulo} · EL FARO · EL ARKA`} descripcion={guia.descripcion} ruta="/faro/guias/diagnostico-ia/">
  <Fragment slot="head">
    {!guia.publicada && <meta name="robots" content="noindex, nofollow" />}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>
  <div class="dx">
    <header class="top">
      <p class="ey">EL FARO · Guía · 3 minutos</p>
      <h1>¿Qué tanto puede la IA cambiar <em>tu negocio?</em></h1>
      <p class="big">10 preguntas. Tu mapa, lo que encontramos y tu plan de 4 semanas.</p>
      <p class="priv">🔒 Tus respuestas no salen de tu teléfono.</p>
    </header>

    <form id="dx" class="s" onsubmit="return false">
      <div class="barra" aria-hidden="true"><i id="avance"></i></div>
      {PREGUNTAS.map((p, i) => (
        <fieldset class="preg" data-i={i}>
          <legend><b>{i + 1}</b>{p.q}</legend>
          {p.o.map((op, v) => (
            <label><input type="radio" name={`p${i}`} value={v} required /><span>{op}</span></label>
          ))}
        </fieldset>
      ))}
    </form>

    <section class="s res" id="resultado" aria-live="polite" hidden>
      <p class="ey">Tu resultado</p>
      <h2 id="r-titulo"></h2>
      <p class="big" id="r-texto"></p>

      <figure class="mapa" aria-label="Tu posición en el mapa de exposición y preparación">
        <svg viewBox="0 0 300 300" role="img">
          <rect x="0" y="0" width="150" height="150" fill="#16243B"/><rect x="150" y="0" width="150" height="150" fill="#1E3A5F"/>
          <rect x="0" y="150" width="150" height="150" fill="#1E3A5F"/><rect x="150" y="150" width="150" height="150" fill="#16243B"/>
          <text x="8" y="20" class="q">Con tiempo,</text><text x="8" y="34" class="q">sin rumbo</text>
          <text x="158" y="20" class="q">El Diluvio te</text><text x="158" y="34" class="q">alcanza primero</text>
          <text x="8" y="282" class="q">Ventaja</text><text x="8" y="294" class="q">para tomar</text>
          <text x="158" y="282" class="q">Listo para</text><text x="158" y="294" class="q">liderar</text>
          <circle id="r-punto" cx="150" cy="150" r="11" fill="#C9963F" stroke="#F4EDE2" stroke-width="3"/>
        </svg>
        <figcaption><span>→ más expuesto a la IA</span><span>↓ más preparado</span></figcaption>
      </figure>
      <div class="ejes">
        <div><span>Exposición</span><b id="r-exp"></b><small>cuánto de tu negocio ya puede hacerlo la IA</small></div>
        <div><span>Preparación</span><b id="r-prep"></b><small>cuánto estás listo para dirigirla</small></div>
      </div>

      <h3>Lo que encontramos en tus respuestas</h3>
      <ul class="hallazgos" id="r-hallazgos"></ul>

      <h3>Tu plan de 4 semanas</h3>
      <ol class="plan" id="r-plan"></ol>

      <a class="btn" id="r-wa" href={WA_CTA} target="_blank" rel="noopener">Recibe acompañamiento de EL ARKA con tu plan →</a>
      <button class="otra" type="button" id="copiar">Copiar mi plan</button>
      <button class="otra" type="button" id="reiniciar">Cambiar mis respuestas</button>
    </section>

    <noscript>
      <section class="s">
        <h2>Los cuatro resultados posibles</h2>
        {Object.values(RESULTADOS).map((r) => <div class="paso"><span>{r.titulo}</span><p>{r.texto} {r.paso}</p></div>)}
      </section>
    </noscript>

    <section class="s nota">
      <p class="meta">Es una autoevaluación para orientarte, no una medición. EL ARKA forma a emprendedores y empresarios de habla hispana para liderar la era de la IA: primero el Ser, después el Poder.</p>
      <a class="volver" href="/faro/">← Volver a EL FARO</a>
    </section>
  </div>
</Base>

<style>
.dx{--luz:#F4EDE2;--card:#FBF7F0;--tinta:#221E18;--borde:#E8E0D2;--meta:#6E6457;--oro:#C9963F;--orot:#7A5A1E;--tor:#0E1726;--niebla:#9BB4C5;background:var(--luz);color:var(--tinta);font:20px/1.5 'Newsreader',Georgia,serif}
.s{max-width:560px;margin:0 auto;padding:36px 22px}
.top{background:radial-gradient(120% 80% at 80% 10%,#1E3A5F,#0E1726 60%);color:var(--luz);padding:64px 22px 40px}
.top>*{max-width:560px;margin-left:auto;margin-right:auto}
.ey{font:600 13px 'Inter',sans-serif;letter-spacing:.18em;text-transform:uppercase;color:var(--orot);margin:0 0 10px}
.top .ey,.res .ey{color:var(--oro)}
h1{font:600 clamp(40px,11vw,60px)/1.04 'Fraunces',Georgia,serif;margin:0;color:var(--luz)}
h1 em{font-style:normal;color:var(--oro)}
.big{font:400 italic 22px/1.4 'Newsreader',Georgia,serif;margin:14px 0 0}
.priv{font:500 14px 'Inter',sans-serif;color:var(--niebla);margin:16px 0 0}
.barra{position:sticky;top:56px;z-index:5;height:6px;background:var(--borde);border-radius:9px;margin-bottom:24px}
.barra i{display:block;height:100%;width:0;background:var(--oro);border-radius:9px;transition:width .35s}
.preg{border:0;margin:0 0 26px;padding:0;scroll-margin-top:90px}
.preg legend{font:600 20px/1.35 'Inter',sans-serif;margin-bottom:12px;display:flex;gap:12px}
.preg legend b{flex:none;width:32px;height:32px;border-radius:50%;border:2px solid var(--oro);color:var(--orot);display:inline-flex;align-items:center;justify-content:center;font-size:14px}
.preg label{display:block;margin:8px 0;cursor:pointer}
.preg input{position:absolute;opacity:0;pointer-events:none}
.preg label span{display:block;background:var(--card);border:2px solid var(--borde);border-radius:16px;padding:14px 16px;font:500 18px 'Inter',sans-serif;transition:border-color .2s,background .2s}
.preg input:checked+span{border-color:var(--oro);background:#F7EDD9}
.preg input:focus-visible+span{outline:3px solid var(--tor);outline-offset:2px}
.res{background:var(--tor);color:var(--luz);border-radius:24px;margin:0 16px 24px;max-width:528px}
@media (min-width:560px){.res{margin:0 auto 24px}}
.res h2{font:600 clamp(32px,9vw,44px)/1.08 'Fraunces',Georgia,serif;margin:0 0 16px;color:var(--luz)}
.ejes{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.ejes div{background:rgba(255,255,255,.06);border:1px solid rgba(201,150,63,.4);border-radius:16px;padding:14px}
.ejes span{display:block;font:600 12px 'Inter',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--oro)}
.ejes b{display:block;font:600 34px 'Fraunces',Georgia,serif}
.ejes small{font:500 13px/1.3 'Inter',sans-serif;color:var(--niebla)}
.paso{background:#F7EDD9;color:var(--tinta);border-radius:18px;padding:18px 20px;margin-top:18px}
.paso span{display:block;font:600 12px 'Inter',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--orot);margin-bottom:6px}
.paso p{margin:0;font:500 19px/1.45 'Inter',sans-serif}
.btn{display:block;text-align:center;background:var(--oro);color:var(--tor);font:600 18px 'Inter',sans-serif;padding:17px;border-radius:16px;margin-top:22px;text-decoration:none}
.otra{display:block;width:100%;margin-top:10px;background:none;border:2px solid rgba(201,150,63,.6);color:var(--oro);font:600 16px 'Inter',sans-serif;padding:13px;border-radius:14px;cursor:pointer}
.mapa{margin:22px 0 10px}
.mapa svg{width:100%;height:auto;border-radius:18px;display:block}
.mapa .q{font:600 12px 'Inter',sans-serif;fill:#9BB4C5}
.mapa circle{transition:cx .8s cubic-bezier(.2,.8,.2,1),cy .8s cubic-bezier(.2,.8,.2,1)}
.mapa figcaption{display:flex;justify-content:space-between;font:500 12px 'Inter',sans-serif;color:var(--niebla);margin-top:6px}
.res h3{font:600 24px/1.2 'Fraunces',Georgia,serif;margin:26px 0 10px;color:var(--luz)}
.hallazgos{list-style:none;padding:0;margin:0;display:grid;gap:8px}
.hallazgos :global(li){background:rgba(255,255,255,.06);border-left:4px solid var(--oro);border-radius:12px;padding:12px 14px;font:500 16px/1.4 'Inter',sans-serif}
.hallazgos :global(li.p3){border-left-color:#E0705A}
.hallazgos :global(li small){display:block;font:600 11px 'Inter',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--oro);margin-bottom:3px}
.plan{list-style:none;padding:0;margin:0;counter-reset:s;display:grid;gap:10px}
.plan :global(li){counter-increment:s;background:#F7EDD9;color:var(--tinta);border-radius:16px;padding:14px 16px 14px 16px;font:500 17px/1.4 'Inter',sans-serif}
.plan :global(li):before{content:"Semana " counter(s);display:block;font:600 12px 'Inter',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--orot);margin-bottom:4px}
.dx.listo #dx{display:none}
.meta{font:500 15px/1.5 'Inter',sans-serif;color:var(--meta)}
.volver{font:600 15px 'Inter',sans-serif;color:var(--orot);text-decoration:none}
@media (prefers-reduced-motion:reduce){.barra i{transition:none}}
</style>

<script>
import { PREGUNTAS, diagnosticar } from "../../../config/diagnostico.js";
import { WA_CTA } from "../../../config/arka.js";
const raiz = document.querySelector(".dx");
const f = document.getElementById("dx");
const res = document.getElementById("resultado");
const av = document.getElementById("avance");
const suave = !matchMedia("(prefers-reduced-motion: reduce)").matches;
const ir = (el) => el.scrollIntoView({ behavior: suave ? "smooth" : "auto", block: "start" });
const leer = () => PREGUNTAS.map((_, i) => { const v = f.querySelector(`input[name=p${i}]:checked`); return v ? +v.value : null; });
const li = (html, cls = "") => { const e = document.createElement("li"); if (cls) e.className = cls; e.innerHTML = html; return e; };
const esc = (t) => t.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));
let resumen = "";
function mostrar(d) {
  document.getElementById("r-titulo").textContent = d.titulo;
  document.getElementById("r-texto").textContent = d.texto;
  document.getElementById("r-exp").textContent = `${d.exp}/10`;
  document.getElementById("r-prep").textContent = `${d.prep}/10`;
  // mapa: x = exposición (0→10 izquierda→derecha), y = preparación (0 arriba → 10 abajo)
  const pt = document.getElementById("r-punto");
  pt.setAttribute("cx", String(20 + d.exp * 26)); pt.setAttribute("cy", String(20 + d.prep * 26));
  const H = document.getElementById("r-hallazgos"); H.replaceChildren();
  d.hallazgos.forEach((x) => H.append(li(`<small>${x.peso === 3 ? "Urgente" : x.peso === 2 ? "Importante" : "A cuidar"}</small>${esc(x.hallazgo)}`, "p" + x.peso)));
  const P = document.getElementById("r-plan"); P.replaceChildren();
  d.plan.forEach((x) => P.append(li(esc(x.accion))));
  resumen = `Mi diagnóstico en EL FARO: ${d.titulo} (exposición ${d.exp}/10, preparación ${d.prep}/10).\nMi plan de 4 semanas:\n` +
    d.plan.map((x, i) => `${i + 1}. ${x.accion}`).join("\n");
  document.getElementById("r-wa").href = WA_CTA.split("?")[0] + "?text=" + encodeURIComponent(
    `Hola, hice el diagnóstico de EL FARO y salió «${d.titulo}». Quiero acompañamiento con mi plan:\n` + d.plan.map((x, i) => `${i + 1}. ${x.accion}`).join("\n"));
  raiz.classList.add("listo"); res.hidden = false; ir(res);
}
f.addEventListener("change", (e) => {
  const r = leer(); const hechas = r.filter((x) => x !== null).length;
  av.style.width = (hechas / PREGUNTAS.length) * 100 + "%";
  if (hechas === PREGUNTAS.length) return mostrar(diagnosticar(r));
  const i = +e.target.closest(".preg").dataset.i;
  const sig = f.querySelector(`.preg[data-i="${i + 1}"]`) || f.querySelector(".preg:not(:has(input:checked))");
  if (sig) ir(sig);
});
document.getElementById("copiar").addEventListener("click", async (e) => {
  try { await navigator.clipboard.writeText(resumen); e.target.textContent = "Copiado ✓"; }
  catch { e.target.textContent = "No se pudo copiar"; }
});
document.getElementById("reiniciar").addEventListener("click", () => {
  raiz.classList.remove("listo"); res.hidden = true; ir(f);
});
</script>

---
/* Bitácora · plantilla única de artículo. El texto vive en src/content/articulos/*.md.
   Un borrador se construye para revisarlo, pero sale con noindex y fuera del índice. */
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { GUIAS } from "../../../config/guias.js";

export async function getStaticPaths() {
  const todos = await getCollection("articulos");
  return todos.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const { Content } = await a.render();
const guia = a.data.guia ? GUIAS.find((g) => g.slug === a.data.guia) : null;
const fecha = a.data.fecha.toLocaleDateString("es-MX", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Base titulo={`${a.data.titulo} · EL ARKA`} descripcion={a.data.descripcion} ruta={`/bitacora/articulos/${a.slug}/`}>
  <Fragment slot="head">
    {a.data.borrador && <meta name="robots" content="noindex, nofollow" />}
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>
  <article class="art">
    {a.data.imagen && <div class="portada" style={`background-image:url(${a.data.imagen})`}></div>}
    <div class="cuerpo">
      {a.data.borrador && <p class="aviso">Borrador · no publicado</p>}
      <p class="ey">{a.data.serie} · {fecha}</p>
      <h1>{a.data.titulo}</h1>
      <p class="lead">{a.data.descripcion}</p>
      {guia && <a class="guia" href={`/bitacora/guias/${guia.slug}/`}>Encuentra el tuyo en 3 preguntas →</a>}
      <div class="texto"><Content /></div>
      {guia && <a class="guia" href={`/bitacora/guias/${guia.slug}/`}>Abrir la guía interactiva →</a>}
      <a class="volver" href="/bitacora/">← Volver a la Bitácora</a>
    </div>
  </article>
</Base>

<style>
.art{--luz:#F4EDE2;--tinta:#221E18;--meta:#6E6457;--oro:#C9963F;--orot:#7A5A1E;--tor:#0E1726;background:var(--luz);color:var(--tinta)}
.portada{height:min(56vh,480px);background:#0E1726 37% 25%/cover no-repeat}
.cuerpo{max-width:640px;margin:0 auto;padding:40px 22px 72px;font:20px/1.65 'Newsreader',Georgia,serif}
.aviso{display:inline-block;background:var(--tor);color:var(--oro);font:600 12px 'Inter',sans-serif;letter-spacing:.14em;text-transform:uppercase;padding:5px 10px;border-radius:99px}
.ey{font:600 13px 'Inter',sans-serif;letter-spacing:.18em;text-transform:uppercase;color:var(--orot);margin:18px 0 10px}
h1{font:600 clamp(36px,9vw,54px)/1.06 'Fraunces',Georgia,serif;margin:0 0 14px}
.lead{font-size:23px;font-style:italic;margin:0 0 22px}
.texto :global(h2){font:600 30px/1.15 'Fraunces',Georgia,serif;margin:38px 0 10px}
.texto :global(strong){font-weight:600}
.guia{display:block;text-align:center;background:var(--oro);color:var(--tor);font:600 18px 'Inter',sans-serif;padding:16px;border-radius:14px;margin:26px 0;text-decoration:none}
.volver{display:inline-block;margin-top:18px;font:600 15px 'Inter',sans-serif;color:var(--orot);text-decoration:none}
</style>

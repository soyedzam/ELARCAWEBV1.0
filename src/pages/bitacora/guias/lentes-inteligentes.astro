---
/* Bitácora · Guía de lentes inteligentes (crear vs viajar)
   Experiencia en tres capas: atención (portada con foto real) → decisión
   (cuestionario de 3 preguntas + tarjetas 3D) → confianza (estrellas reales,
   preguntas antes de pagar) → pertenencia (criterio de la casa).
   Piel: Eje Rector v1.1 (Luz · Tormenta · Oro), acotada a .lentes.
   Mejora progresiva: sin JS todo el contenido se ve; el JS sólo suma gesto. */
import Base from "../../../layouts/Base.astro";
import { LENTES, CORTE } from "../../../config/lentes.js";
import { GUIAS } from "../../../config/guias.js";
const publicada = GUIAS.find((g) => g.slug === "lentes-inteligentes")?.publicada;

const crear = LENTES.filter((l) => l.uso === "crear");
const viajar = LENTES.filter((l) => l.uso === "viajar");

const estrellas = (n) => {
  if (n == null) return null;
  const llenas = Math.floor(n);
  const media = n - llenas >= 0.5;
  return { llenas, media, vacias: 5 - llenas - (media ? 1 : 0) };
};
---
<Base
  titulo="Lentes inteligentes 2026: cuál comprar para crear y para viajar · EL ARKA"
  descripcion="Dos lentes, dos trabajos. Guía de EL ARKA con precios en México y reputación real: teleprompter y cámara para crear, monitor de Mac para viajar."
  ruta="/bitacora/guias/lentes-inteligentes/"
  claseMain="lentes-main"
>
  <Fragment slot="head">
    {!publicada && <meta name="robots" content="noindex, nofollow" />}
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="lentes">
    <!-- 1 · ATENCIÓN -->
    <section class="hero">
      <div class="hero-copy">
        <span class="pill">⭐ Guía 2026 · precios en México</span>
        <h1>Tu oficina ya no tiene <em>escritorio.</em></h1>
        <p class="big it">Dos lentes. Uno para crear. Otro para viajar.</p>
        <a class="scroll" href="#elige">Encuentra el tuyo en 3 preguntas ↓</a>
      </div>
    </section>

    <!-- 2 · DECISIÓN: cuestionario -->
    <section class="s" id="elige">
      <p class="ey">Elige en 30 segundos</p>
      <h2>¿Cuál es para ti?</h2>
      <form class="quiz" id="quiz" onsubmit="return false">
        <fieldset>
          <legend><b>1</b> ¿Para qué los quieres?</legend>
          <label><input type="radio" name="uso" value="crear" required /> <span>🎬 Grabar y hablar a cámara</span></label>
          <label><input type="radio" name="uso" value="viajar" /> <span>✈️ Trabajar lejos del escritorio</span></label>
          <label><input type="radio" name="uso" value="ambos" /> <span>✨ Las dos cosas</span></label>
        </fieldset>
        <fieldset>
          <legend><b>2</b> ¿Usas graduación?</legend>
          <label><input type="radio" name="graduacion" value="si" required /> <span>Sí</span></label>
          <label><input type="radio" name="graduacion" value="no" /> <span>No</span></label>
        </fieldset>
        <fieldset>
          <legend><b>3</b> ¿Necesitas comprarlo ya, en México?</legend>
          <label><input type="radio" name="mx" value="si" required /> <span>Sí, ya</span></label>
          <label><input type="radio" name="mx" value="no" /> <span>Puedo importar</span></label>
        </fieldset>
        <div class="resultado" id="resultado" aria-live="polite" hidden></div>
      </form>
      <noscript><p class="meta">Abajo están las dos recomendaciones completas.</p></noscript>
    </section>

    {[
      { id: "crear", n: "01", ey: "Para crear", h: "Lees el guion. Miras a la cámara.", lista: crear, uso: null },
      { id: "viajar", n: "02", ey: "Para viajar", h: "Tu Mac, en grande, donde estés.", lista: viajar,
        uso: { img: "/assets/lentes/xreal-uso-sofa.jpg", txt: "Así se ve: una pantalla flotando frente a ti" } },
    ].map((sec) => (
      <section class="s" id={sec.id}>
        <p class="ey">{sec.n} · {sec.ey}</p>
        <h2>{sec.h}</h2>
        {sec.uso && (
          <figure class="uso"><img src={sec.uso.img} alt="Persona en un sillón con una pantalla virtual grande" loading="lazy" width="900" height="600" /><figcaption>{sec.uso.txt}</figcaption></figure>
        )}
        <div class="cards">
          {sec.lista.map((l) => {
            const e = estrellas(l.estrellas);
            return (
              <article class={`card${l.top ? " top" : ""}`} id={l.id} data-id={l.id}>
                <div class={`stage ${l.fondo}`} data-tilt>
                  <div class="glow"></div>
                  {l.img ? (
                    <img class="obj" src={l.img} alt={l.nombre} loading="lazy" draggable="false" />
                  ) : (
                    <span class="obj ph" aria-hidden="true">👓</span>
                  )}
                  {l.top && <span class="badge">⭐ El mejor hoy</span>}
                  <span class="hint" aria-hidden="true">↔ gira</span>
                </div>
                <div class="head">
                  <h3>{l.nombre}</h3>
                  <p class="price">{l.precio}</p>
                  <p class="where">{l.donde}</p>
                  <div class="rate">
                    {e ? (
                      <span class="stars" aria-label={`${l.estrellas} de 5 estrellas`}>
                        {"★".repeat(e.llenas)}{e.media && <span class="half">★</span>}<span class="off">{"★".repeat(e.vacias)}</span>
                      </span>
                    ) : null}
                    {e && <b>{l.estrellas.toFixed(1)}</b>}
                    <small>{l.resenas ? `${l.resenas} reseñas · ` : ""}{l.fuenteResenas}</small>
                  </div>
                </div>
                <ul class="does">{l.hace.map(([i, t]) => <li><span>{i}</span>{t}</li>)}</ul>
                <ul class="pc">
                  {l.ventajas.map((t) => <li><span>✅</span>{t}</li>)}
                  {l.desventajas.map((t) => <li><span>⚠️</span>{t}</li>)}
                </ul>
                <a class="cta" href={l.url} target="_blank" rel="noopener">{l.cta} →</a>
              </article>
            );
          })}
        </div>
      </section>
    ))}

    <!-- 3 · CONFIANZA -->
    <section class="s card-bg">
      <p class="ey">Antes de pagar</p>
      <h2>Tres preguntas.</h2>
      <ol class="check">
        <li>¿Acepta tu graduación?</li>
        <li>¿El vendedor tiene buena reputación y garantía?</li>
        <li>¿Lo vas a usar más de 1 hora al día?</li>
      </ol>
      <p class="meta">Estrellas: calificación real de compradores en tiendas de México, vista el {CORTE}. Ningún lente está probado como protección de la vista. EL ARKA los prueba 7 días antes de recomendarlos sin reservas.</p>
    </section>

    <!-- 4 · PERTENENCIA -->
    <section class="s dark">
      <p class="ey">El criterio de la casa</p>
      <p class="quote">Primero el Ser, después el Poder.</p>
      <p class="big">El equipo no te hace constructor. Te quita fricción.</p>
      <a class="btn" href="/">Conoce EL ARKA</a>
    </section>
  </div>
</Base>

<style>
.lentes{--luz:#F4EDE2;--card:#FBF7F0;--tinta:#221E18;--borde:#E8E0D2;--meta:#6E6457;--tor:#0E1726;--niebla:#9BB4C5;--oro:#C9963F;--orot:#7A5A1E;
  --disp:'Fraunces',Georgia,serif;--ed:'Newsreader',Georgia,serif;--ui:'Inter',system-ui,sans-serif;
  background:var(--luz);color:var(--tinta);font:20px/1.5 var(--ed);overflow-x:clip}
.lentes *{box-sizing:border-box}
.lentes a{color:inherit;text-decoration:none}
.s{max-width:560px;margin:0 auto;padding:48px 22px}
.ey{font:600 13px/1.3 var(--ui);letter-spacing:.18em;text-transform:uppercase;color:var(--orot);margin:0 0 12px}
.lentes h2{font:600 clamp(34px,8vw,44px)/1.08 var(--disp);margin:0 0 14px;color:var(--tinta)}
.big{font:400 23px/1.4 var(--ed);margin:14px 0 0}.it{font-style:italic}
.meta{font:500 15px/1.5 var(--ui);color:var(--meta)}
.dark{max-width:none;background:var(--tor);color:var(--luz)}.dark>*{max-width:516px;margin-left:auto;margin-right:auto}
.dark .ey{color:var(--oro)}
.card-bg{max-width:none;background:var(--card)}.card-bg>*{max-width:516px;margin-left:auto;margin-right:auto}

/* portada */
.hero{position:relative;min-height:min(92vh,820px);display:flex;align-items:flex-end;color:var(--luz);
  background:#0E1726 url(/assets/lentes/hero-meta-display-uso.jpg) 37% 20%/cover no-repeat}
.hero:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,23,38,.55) 0%,rgba(14,23,38,.05) 30%,rgba(14,23,38,.55) 58%,#0E1726 94%)}
.hero-copy{position:relative;max-width:560px;width:100%;margin:0 auto;padding:0 22px 44px}
.hero h1{font:600 clamp(48px,13vw,72px)/1.0 var(--disp);margin:0;color:var(--luz)}
.hero h1 em{font-style:normal;color:var(--oro)}
.pill{display:inline-block;background:rgba(14,23,38,.6);border:1px solid rgba(201,150,63,.6);border-radius:99px;padding:6px 12px;font:500 13px var(--ui);margin-bottom:16px}
.scroll{display:inline-block;margin-top:24px;font:600 15px var(--ui);color:var(--tor)!important;background:var(--oro);padding:14px 18px;border-radius:14px}

/* cuestionario */
.quiz fieldset{border:0;margin:0 0 20px;padding:0}
.quiz legend{font:600 19px/1.3 var(--ui);margin-bottom:10px;display:flex;gap:10px;align-items:center}
.quiz legend b{width:30px;height:30px;border-radius:50%;border:2px solid var(--oro);color:var(--orot);display:inline-flex;align-items:center;justify-content:center;font-size:14px;flex:none}
.quiz label{display:block;margin:8px 0;cursor:pointer}
.quiz input{position:absolute;opacity:0;pointer-events:none}
.quiz label span{display:block;background:var(--card);border:2px solid var(--borde);border-radius:16px;padding:14px 16px;font:500 18px var(--ui);transition:border-color .2s,background .2s,transform .15s}
.quiz input:checked+span{border-color:var(--oro);background:#F7EDD9;transform:scale(1.01)}
.quiz input:focus-visible+span{outline:3px solid var(--tor);outline-offset:2px}
.resultado{background:var(--tor);color:var(--luz);border-radius:20px;padding:22px;margin-top:8px;animation:sube .45s ease both}
.resultado :global(p){margin:0 0 6px;font:500 14px var(--ui);letter-spacing:.14em;text-transform:uppercase;color:var(--oro)}
.resultado :global(a){display:flex;justify-content:space-between;align-items:center;gap:10px;background:rgba(255,255,255,.06);border:1px solid rgba(201,150,63,.5);border-radius:14px;padding:14px 16px;margin-top:10px;font:600 22px/1.2 var(--disp)}
.resultado :global(a span){font:600 14px var(--ui);color:var(--oro);white-space:nowrap}
@keyframes sube{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

/* tarjetas */
.cards{display:grid;gap:20px;margin-top:20px}
.card{background:var(--card);border:1px solid var(--borde);border-radius:24px;overflow:hidden;box-shadow:0 18px 40px -22px rgba(14,23,38,.55);scroll-margin-top:90px;transition:box-shadow .3s}
.card.top{border:2px solid var(--oro)}
.card.elegida{box-shadow:0 0 0 4px var(--oro),0 24px 50px -20px rgba(14,23,38,.6)}
.stage{position:relative;height:250px;perspective:900px;overflow:hidden;touch-action:pan-y;cursor:grab;user-select:none}
.stage.oscuro{background:radial-gradient(120% 90% at 50% 15%,#2C4E73 0%,#16243B 48%,#0A111C 100%)}
.stage.claro,.stage.foto{background:radial-gradient(120% 90% at 50% 15%,#fff 0%,#EFE7DA 55%,#D8CFBF 100%)}
.stage:after{content:"";position:absolute;left:16%;right:16%;bottom:26px;height:24px;background:radial-gradient(closest-side,rgba(0,0,0,.5),transparent);filter:blur(4px)}
.stage .glow{position:absolute;left:50%;top:45%;width:240px;height:240px;transform:translate(-50%,-50%);background:radial-gradient(closest-side,rgba(201,150,63,.35),transparent);filter:blur(10px)}
.obj{position:absolute;left:50%;top:47%;width:88%;max-height:88%;object-fit:contain;
  transform:translate(-50%,-50%) rotateX(var(--rx,10deg)) rotateY(var(--ry,-16deg));
  filter:drop-shadow(0 26px 22px rgba(0,0,0,.45));transition:transform .5s cubic-bezier(.2,.8,.2,1);z-index:1;will-change:transform}
.stage.claro .obj{mix-blend-mode:multiply}
.stage.foto .obj{width:100%;height:100%;max-height:none;top:50%;object-fit:cover;filter:none;transform:translate(-50%,-50%) scale(1.06) rotateX(calc(var(--rx,0deg)/3)) rotateY(calc(var(--ry,0deg)/3))}
.stage.foto:after,.stage.foto .glow{display:none}
.stage.arrastra .obj{transition:none}
.obj.ph{font-size:110px;line-height:1;width:auto;text-align:center}
.badge{position:absolute;left:14px;top:14px;z-index:2;background:var(--oro);color:var(--tor);font:600 12px var(--ui);letter-spacing:.14em;text-transform:uppercase;padding:5px 11px;border-radius:99px}
.hint{position:absolute;right:12px;bottom:10px;z-index:2;font:600 11px var(--ui);letter-spacing:.14em;text-transform:uppercase;color:var(--meta);background:rgba(251,247,240,.8);padding:4px 8px;border-radius:99px}
.stage.oscuro .hint{background:rgba(14,23,38,.6);color:var(--niebla)}
.head{background:var(--tor);color:var(--luz);padding:20px 22px}
.head h3{font:600 30px/1.08 var(--disp);margin:0 0 6px;color:var(--luz)}
.price{font:600 22px var(--ui);color:var(--oro);margin:0}
.where{font:500 15px var(--ui);color:var(--niebla);margin:2px 0 0}
.rate{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:14px;padding-top:14px;border-top:1px solid #1E3A5F}
.stars{font-size:22px;letter-spacing:2px;color:var(--oro)}.stars .off{color:#2C4E73}
.stars .half{background:linear-gradient(90deg,var(--oro) 50%,#2C4E73 50%);-webkit-background-clip:text;background-clip:text;color:transparent}
.rate b{font:600 20px var(--ui)}.rate small{font:500 13px var(--ui);color:var(--niebla)}
.does{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:18px 18px 4px;margin:0}
.does li{background:var(--luz);border-radius:14px;padding:13px 6px;text-align:center;font:600 14px/1.25 var(--ui)}
.does span{display:block;font-size:28px;margin-bottom:6px}
.pc{list-style:none;padding:6px 22px 18px;margin:0}
.pc li{margin:11px 0 0;font:500 18px/1.4 var(--ui);display:flex;gap:10px}
.cta{display:block;margin:2px 18px 20px;text-align:center;background:var(--oro);color:var(--tor)!important;font:600 17px var(--ui);padding:15px;border-radius:14px}
.uso{margin:20px 0 0;border-radius:22px;overflow:hidden;position:relative;box-shadow:0 18px 40px -22px rgba(14,23,38,.55)}
.uso img{width:100%;height:auto;display:block}
.uso figcaption{position:absolute;left:14px;bottom:14px;background:rgba(14,23,38,.78);color:var(--luz);font:500 14px var(--ui);padding:7px 12px;border-radius:99px}
.check{padding-left:0;list-style:none;counter-reset:c}
.check li{counter-increment:c;display:flex;gap:14px;align-items:flex-start;margin:18px 0;font:500 20px/1.35 var(--ui)}
.check li:before{content:counter(c);flex:none;width:34px;height:34px;border-radius:50%;border:2px solid var(--oro);color:var(--orot);display:flex;align-items:center;justify-content:center;font:600 16px var(--ui)}
.quote{font:600 clamp(36px,9vw,48px)/1.08 var(--disp);margin:0}
.btn{display:block;text-align:center;background:var(--oro);color:var(--tor)!important;font:600 19px var(--ui);padding:18px;border-radius:16px;margin-top:28px}
@media (min-width:900px){.cards{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.s:not(.dark):not(.card-bg){max-width:1040px}#elige{max-width:560px}}
@media (prefers-reduced-motion:reduce){.obj,.resultado,.quiz label span{transition:none;animation:none}}
</style>

<script>
import { LENTES, recomendar } from "../../../config/lentes.js";

/* Cuestionario: al completar las 3 respuestas, recomienda y resalta. */
const quiz = document.getElementById("quiz");
const out = document.getElementById("resultado");
quiz?.addEventListener("change", () => {
  const f = new FormData(quiz);
  const uso = f.get("uso"), grad = f.get("graduacion"), mx = f.get("mx");
  if (!uso || !grad || !mx) return;
  const ids = recomendar({ uso, graduacion: grad === "si", yaEnMexico: mx === "si" });
  document.querySelectorAll(".card.elegida").forEach((c) => c.classList.remove("elegida"));
  out.innerHTML = '<p>Tu recomendación</p>' + ids.map((id) => {
    const l = LENTES.find((x) => x.id === id);
    document.getElementById(id)?.classList.add("elegida");
    return `<a href="#${id}">${l.nombre}<span>${l.precio} ↓</span></a>`;
  }).join("");
  out.hidden = false;
});

/* Tarjetas 3D: el lente gira con el dedo o el ratón; flota solo si no hay gesto. */
const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
document.querySelectorAll("[data-tilt]").forEach((st) => {
  const obj = st.querySelector(".obj");
  if (!obj) return;
  let x0 = null, ry0 = -16;
  const set = (ry, rx) => { obj.style.setProperty("--ry", ry + "deg"); obj.style.setProperty("--rx", rx + "deg"); };
  st.addEventListener("pointerdown", (e) => { x0 = e.clientX; st.classList.add("arrastra"); st.setPointerCapture(e.pointerId); });
  st.addEventListener("pointermove", (e) => {
    const r = st.getBoundingClientRect();
    const ny = (e.clientY - r.top) / r.height - 0.5;
    if (x0 !== null) set(Math.max(-55, Math.min(55, ry0 + (e.clientX - x0) * 0.35)), 10 - ny * 20);
    else if (e.pointerType === "mouse" && !quieto) set(((e.clientX - r.left) / r.width - 0.5) * 40, 10 - ny * 20);
  });
  const suelta = () => { x0 = null; st.classList.remove("arrastra"); set(-16, 10); };
  st.addEventListener("pointerup", suelta);
  st.addEventListener("pointercancel", suelta);
  st.addEventListener("pointerleave", () => { if (x0 === null) set(-16, 10); });
});
</script>

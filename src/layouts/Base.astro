---
/* Layout compartido de EL ARKA · v2.0
   La ductería del sitio: nav, pie, grano, línea de flotación y el
   menú móvil que antes no existía bajo 920px. */
import "../styles/tokens.css";
import { WA_CTA, NAV, SITIO } from "../config/arka.js";

const { titulo, descripcion, ruta = "/", claseMain = "" } = Astro.props;
const url = `${SITIO.origen}${ruta}`;
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{titulo}</title>
<meta name="description" content={descripcion} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="theme-color" content="#0B1F33" />
<link rel="canonical" href={url} />
<link rel="icon" href="/assets/arka-simbolo-marfil.svg" />
<link rel="apple-touch-icon" href="/assets/arka-simbolo-marfil.svg" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="EL ARKA" />
<meta property="og:locale" content="es_MX" />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={url} />
<meta property="og:image" content={`${SITIO.origen}/assets/arca-hero-poster.jpg`} />
<meta name="twitter:card" content="summary_large_image" />

<!-- Capa legible por máquinas -->
<link rel="alternate" type="application/json" href="/brand.json" title="EL ARKA · marca legible por máquinas" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..600;1,8..60,300..600&display=swap" rel="stylesheet" />

<slot name="head" />

<style>
/* ── Línea de flotación: el gesto propietario. El agua sube al leer. ── */
.flotacion{position:fixed;top:0;left:0;width:3px;height:100vh;z-index:70;
  background:rgba(40,184,216,.07);pointer-events:none}
.flotacion span{position:absolute;top:0;left:0;width:100%;height:0;
  background:linear-gradient(180deg,var(--agua-luz),var(--lluvia) 55%,var(--arkadia));
  box-shadow:0 0 12px rgba(40,184,216,.45)}

/* ── Nav ── */
.nav{position:fixed;top:0;left:0;width:100%;z-index:80;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:16px clamp(20px,5vw,56px);
  background:linear-gradient(180deg,rgba(6,20,31,.82),rgba(6,20,31,0));
  border-bottom:1px solid transparent;
  transition:background var(--dur-media) var(--ease),padding var(--dur-media) var(--ease),
             border-color var(--dur-media) var(--ease)}
.nav.solido{background:rgba(8,24,38,.94);backdrop-filter:blur(16px) saturate(120%);
  border-bottom-color:var(--linea-tenue);padding-top:11px;padding-bottom:11px}
.marca{display:inline-flex;align-items:center;gap:12px;flex:none}
.marca svg{width:26px;height:35px;flex:none;
  transition:transform var(--dur-media) var(--ease)}
.marca:hover svg{transform:translateY(-2px)}
.marca .wm{font-family:var(--sans);font-weight:500;font-size:19px;letter-spacing:.3em;
  color:var(--marfil);line-height:1;padding-left:.3em}
.marca .wm b{font-weight:var(--peso-sentencia);color:var(--marfil)}

.enlaces{display:none;gap:4px;align-items:center}
@media(min-width:940px){.enlaces{display:flex}}
.enlaces a{font-family:var(--sans);font-size:11.5px;font-weight:500;
  letter-spacing:var(--track-inline);text-transform:uppercase;
  color:var(--tinta-tenue);padding:9px 13px;border-radius:var(--borde);
  transition:color var(--dur-corta) var(--ease)}
.enlaces a:hover{color:var(--marfil)}
.enlaces a[aria-current="page"]{color:var(--marfil)}
.enlaces a[aria-current="page"]::after{content:"";display:block;height:1px;
  background:var(--terracota);margin-top:5px}

.cta-nav{font-family:var(--sans);font-size:11.5px;font-weight:var(--peso-sentencia);
  letter-spacing:var(--track-inline);text-transform:uppercase;
  background:var(--terracota);color:var(--marfil);padding:11px 18px;
  border-radius:var(--borde);white-space:nowrap;flex:none;
  transition:background var(--dur-corta) var(--ease),transform var(--dur-corta) var(--ease)}
.cta-nav:hover{background:var(--terra-luz);transform:translateY(-1px)}

/* Menú móvil: antes no existía bajo 920px y la única ruta era scrollear todo */
.abrir-menu{display:inline-flex;flex-direction:column;justify-content:center;gap:5px;
  width:42px;height:42px;padding:11px;background:none;border:1px solid var(--linea);
  border-radius:var(--borde);cursor:pointer;flex:none}
@media(min-width:940px){.abrir-menu{display:none}}
.abrir-menu span{display:block;height:1.5px;background:var(--marfil);
  transition:transform var(--dur-corta) var(--ease),opacity var(--dur-corta) var(--ease)}
.abrir-menu[aria-expanded="true"] span:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.abrir-menu[aria-expanded="true"] span:nth-child(2){opacity:0}
.abrir-menu[aria-expanded="true"] span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}

.menu{position:fixed;inset:0;z-index:79;background:var(--hondo);
  display:flex;flex-direction:column;justify-content:center;gap:6px;
  padding:96px clamp(24px,7vw,56px) 48px;
  opacity:0;visibility:hidden;transition:opacity var(--dur-media) var(--ease),visibility var(--dur-media)}
.menu.abierto{opacity:1;visibility:visible}
.menu a{font-family:var(--sans);font-weight:var(--peso-aire);
  font-size:clamp(28px,7vw,42px);letter-spacing:-.02em;color:var(--marfil);
  padding:11px 0;border-bottom:1px solid var(--linea-tenue)}
.menu a .n{font-family:var(--sans);font-size:11px;font-weight:600;
  letter-spacing:var(--track-inline);color:var(--terra-luz);
  display:block;margin-bottom:3px}
.menu .pie-menu{margin-top:28px;display:flex;gap:12px;flex-wrap:wrap}

/* ── Pie ── */
footer{background:var(--hondo);padding:var(--aire-base) clamp(20px,5vw,56px) 48px;
  border-top:1px solid var(--linea-tenue);position:relative;z-index:2}
.pie{max-width:var(--ancho-max);margin:0 auto;display:grid;gap:44px}
@media(min-width:860px){.pie{grid-template-columns:1.3fr 1fr 1fr}}
.pie .lema{font-family:var(--sans);font-weight:var(--peso-aire);
  font-size:var(--t-sub);line-height:1.2;letter-spacing:-.025em;max-width:18ch}
.pie .lema b{font-weight:var(--peso-sentencia)}
.pie .nota{margin-top:16px;font-size:var(--t-menor);color:var(--tinta-tenue);max-width:40ch;line-height:1.6}
.pie h4{font-family:var(--sans);font-size:var(--t-micro);font-weight:600;
  letter-spacing:var(--track-inline);text-transform:uppercase;
  color:var(--tinta-tenue);margin-bottom:16px}
.pie ul{list-style:none;display:grid;gap:9px}
.pie ul a{font-size:var(--t-menor);color:var(--tinta-suave);
  transition:color var(--dur-corta) var(--ease)}
.pie ul a:hover{color:var(--marfil)}
.pie .externo::after{content:" ↗";color:var(--tinta-tenue);font-size:11px}

.cierre{max-width:var(--ancho-max);margin:44px auto 0;padding-top:24px;
  border-top:1px solid var(--linea-tenue);
  display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;
  font-family:var(--sans);font-size:var(--t-micro);letter-spacing:.06em;
  color:var(--tinta-tenue);line-height:2}
.cierre a{color:var(--tinta-tenue)}
.cierre a:hover{color:var(--marfil)}

main{position:relative;z-index:1}
.saltar{position:absolute;left:-9999px;top:0;z-index:100;
  background:var(--terracota);color:var(--marfil);padding:12px 20px;
  font-family:var(--sans);font-size:12px;letter-spacing:var(--track-inline);
  text-transform:uppercase;font-weight:600}
.saltar:focus{left:12px;top:12px}
</style>
</head>
<body>
<script is:inline>document.documentElement.classList.add('js')</script>

<a href="#contenido" class="saltar">Saltar al contenido</a>
<div class="flotacion" aria-hidden="true"><span id="flotacion-nivel"></span></div>
<div class="grano" aria-hidden="true"></div>

<header class="nav" id="nav">
  <a href="/" class="marca" aria-label="EL ARKA · inicio">
    <svg viewBox="0 0 200 266" fill="none" aria-hidden="true">
      <rect x="97.2" y="0" width="5.6" height="38" fill="#28B8D8"/>
      <rect x="98.45" y="41.5" width="3.1" height="20" fill="#F4F0E8"/>
      <path fill="#F4F0E8" d="M94 45C61 60 30 93 16 132 10 155 15 174 33 190.5 26 171 25 152 30 133 40 98 66 67 97 50Z"/>
      <path fill="#F4F0E8" d="M106 45C139 60 170 93 184 132 190 155 185 174 167 190.5 174 171 175 152 170 133 160 98 134 67 103 50Z"/>
      <path fill="#F4F0E8" fill-rule="evenodd" d="M100 60 162 186Q100 178.5 38 186Z M100 105 141 171 107.94 171A12 12 0 1 0 92.06 171L59 171Z M100 112 128 160 104 160 104 170.4 96 170.4 96 160 72 160Z"/>
      <circle cx="100" cy="180" r="9" fill="#B76547"/>
      <path fill="#F4F0E8" d="M38 188C24 190.5 8 194.5 0 200 12 198.5 28 195 39 193.5Z"/>
      <path fill="#F4F0E8" d="M162 188C176 190.5 192 194.5 200 200 188 198.5 172 195 161 193.5Z"/>
      <path fill="#F4F0E8" d="M27 201.5C53 196 77 193.5 96.9 192.8L96.9 258C77 241.5 48 222 27 201.5Z"/>
      <path fill="#F4F0E8" d="M173 201.5C147 196 123 193.5 103.1 192.8L103.1 258C123 241.5 152 222 173 201.5Z"/>
    </svg>
    <span class="wm">EL <b>ARKA</b></span>
  </a>

  <nav class="enlaces" aria-label="Secciones">
    {NAV.map((n) => (
      <a href={n.ruta} aria-current={ruta === n.ruta ? "page" : undefined}>{n.corto}</a>
    ))}
  </nav>

  <div style="display:flex;gap:10px;align-items:center">
    <a class="cta-nav" href={WA_CTA} target="_blank" rel="noopener">Solicitar abordar</a>
    <button class="abrir-menu" id="abrir-menu" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" aria-hidden="true">
  {NAV.map((n) => (
    <a href={n.ruta}><span class="n">{n.numero}</span>{n.titulo}</a>
  ))}
  <div class="pie-menu">
    <a class="boton principal" href={WA_CTA} target="_blank" rel="noopener">Solicitar abordar</a>
    <a class="boton contorno" href="/prensa/">Prensa y marca</a>
  </div>
</div>

<main id="contenido" class={claseMain}>
  <slot />
</main>

<footer>
  <div class="pie">
    <div>
      <p class="lema">El mundo entrena para usar la IA.<br><b>EL ARKA te forma para liderarla.</b></p>
      <p class="nota">Comunidad y organización sin fines de lucro que forma a emprendedores
        y empresarios de habla hispana para liderar la era de la Inteligencia Artificial.</p>
    </div>
    <div>
      <h4>La travesía</h4>
      <ul>
        {NAV.map((n) => <li><a href={n.ruta}>{n.titulo}</a></li>)}
      </ul>
    </div>
    <div>
      <h4>La flota</h4>
      <ul>
        <li><a class="externo" href="https://techovenezuela.elarka.ong" target="_blank" rel="noopener">Techo Venezuela</a></li>
        <li><a class="externo" href="https://clubconectate.elarka.ong" target="_blank" rel="noopener">Club Conéctate</a></li>
        <li><a href="/conectate/">La Proa</a></li>
        <li><a href="/prensa/">Prensa y marca</a></li>
      </ul>
    </div>
  </div>
  <div class="cierre">
    <span>EL ARKA · nodo cero · organización sin fines de lucro · Mérida, Yucatán</span>
    <span>Ed Zam y Val Mosquera · <a href="/arquitectos/">Los Arquitectos</a></span>
  </div>
</footer>

<script is:inline>
(function(){
  /* Nav sólido + línea de flotación */
  var nav=document.getElementById('nav'), nivel=document.getElementById('flotacion-nivel');
  function alScroll(){
    var y=window.scrollY||document.documentElement.scrollTop;
    nav.classList.toggle('solido', y>40);
    var h=document.documentElement.scrollHeight-window.innerHeight;
    nivel.style.height=(h>0?(y/h*100):0)+'vh';
  }
  window.addEventListener('scroll',alScroll,{passive:true}); alScroll();

  /* Menú móvil */
  var btn=document.getElementById('abrir-menu'), menu=document.getElementById('menu');
  function cerrar(){btn.setAttribute('aria-expanded','false');menu.classList.remove('abierto');
    menu.setAttribute('aria-hidden','true');document.body.style.overflow=''}
  btn.addEventListener('click',function(){
    var abierto=btn.getAttribute('aria-expanded')==='true';
    if(abierto){cerrar()}else{
      btn.setAttribute('aria-expanded','true');menu.classList.add('abierto');
      menu.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';
    }
  });
  menu.querySelectorAll('a').forEach(function(a){a.addEventListener('click',cerrar)});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')cerrar()});

  /* Reveal — con red de seguridad: si el observador no dispara,
     el contenido se muestra igual. Nunca una pantalla en blanco. */
  var piezas=[].slice.call(document.querySelectorAll('.revelar'));
  if('IntersectionObserver' in window && piezas.length){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('dentro');io.unobserve(e.target)}})
    },{threshold:.12,rootMargin:'0px 0px -6% 0px'});
    piezas.forEach(function(el){io.observe(el)});
    setTimeout(function(){piezas.forEach(function(el){
      if(el.getBoundingClientRect().top < window.innerHeight) el.classList.add('dentro');
    })},1200);
  } else {
    piezas.forEach(function(el){el.classList.add('dentro')});
  }
})();
</script>
</body>
</html>
